---
import {
    projectSortKey,
    readingTime,
    visibleStatus,
    writtenSortKey,
    type Entry,
} from '../lib/entries';
import { allTagHues } from '../lib/tagColors';

interface Props {
    entries: Entry[];
}

const { entries } = Astro.props;
const tagHues = await allTagHues();
/* same spectrum order as the tag cloud */
const hueOrder = (tags: string[]) =>
    [...tags].sort((a, b) => (tagHues.get(a) ?? 0) - (tagHues.get(b) ?? 0));
---

<ul class="entry-list">
    {
        entries.map((entry, index) => (
            <li
                data-order={index}
                data-project={projectSortKey(entry)}
                data-written={writtenSortKey(entry)}
                data-reading={readingTime(entry)}
                data-tags={entry.data.tags.join('|')}
            >
                <h2>
                    <a href={`/entries/${entry.id}/`}>{entry.data.title} &rarr;</a>
                </h2>
                <p>{entry.data.description}</p>
                {(entry.data.project || entry.data.written || visibleStatus(entry)) && (
                    <p class="meta">
                        {[
                            entry.data.project &&
                                `Developed during ${entry.data.project}`,
                            entry.data.written && `Written ${entry.data.written}`,
                            visibleStatus(entry),
                        ]
                            .filter(Boolean)
                            .join(' · ')}
                    </p>
                )}
                {entry.data.tags.length > 0 && (
                    <ul class="tags">
                        {hueOrder(entry.data.tags).map((tag) => (
                            <li>
                                <a
                                    href={`/tags/${tag}/`}
                                    style={`--tag-hue: ${tagHues.get(tag)}`}
                                >
                                    {tag}
                                </a>
                            </li>
                        ))}
                    </ul>
                )}
                <span class="reading-time">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        aria-hidden="true"
                    >
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />
                    </svg>
                    {readingTime(entry)} min
                </span>
            </li>
        ))
    }
</ul>

<style>
    .entry-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .entry-list > li {
        position: relative;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--border);
        transition: transform 0.2s ease;
    }

    .entry-list > li:hover {
        transform: scale(1.02);
    }

    .entry-list > li:first-child {
        padding-top: 0;
    }

    /* the footer's top border already closes off the list */
    .entry-list > li:last-child,
    .entry-list > li.last-visible {
        border-bottom: none;
        padding-bottom: 0;
    }

    .entry-list h2 {
        font-size: 1.6rem;
        margin: 0;
    }

    .entry-list h2 a {
        color: var(--accent);
        text-decoration: none;
        /*
         * Underline drawn as a background gradient rather than a
         * pseudo-element: ::after is taken by the stretched link, and
         * positioning the anchor would break that overlay's extent.
         */
        display: inline-block;
        padding-bottom: 0.15rem;
        background-image: linear-gradient(var(--accent), var(--accent));
        background-repeat: no-repeat;
        background-position: 0 100%;
        background-size: 0 2px;
        transition: background-size 0.2s ease;
    }

    /*
     * Stretch the title link over the entire list item, making the
     * whole card clickable without nesting anchors.
     */
    .entry-list h2 a::after {
        content: '';
        position: absolute;
        inset: 0;
    }

    .entry-list > li:hover h2 a {
        background-size: 100% 2px;
    }

    .entry-list p {
        margin: 0.4rem 0 0;
        color: var(--muted);
        font-size: 1.05rem;
    }

    .entry-list .meta {
        font-size: 0.85rem;
        margin-top: 0.3rem;
    }

    /* tags sit above the stretched link so they stay clickable */
    .entry-list .tags {
        position: relative;
        z-index: 1;
        width: fit-content;
    }

    /*
     * The stretched title link sits over the card, so the time never
     * gets hovered directly — brighten it on card hover instead.
     */
    .entry-list > li:hover :global(.reading-time) {
        color: #fff;
    }
</style>
