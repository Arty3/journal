---
import { projectBounds, writtenSortKey, type Entry } from '../lib/entries';

interface Props {
    entries: Entry[];
}

const { entries } = Astro.props;

const yearOf = (key: number) => Math.floor(key / 12);
const newestFirst = (years: Iterable<number>) => [...new Set(years)].sort((a, b) => b - a);

const writtenYears = newestFirst(entries.map(writtenSortKey).map(yearOf));
/* a project spanning years is offered under each year it touched */
const projectYears = newestFirst(
    entries.flatMap((entry) => {
        const { start, end } = projectBounds(entry);
        const years = [];
        for (let year = yearOf(start); year <= yearOf(end); year++) years.push(year);
        return years;
    }),
);
---

<form class="entry-controls">
    <div class="sort-group">
        <label>
            Sort by:
            <select name="sort">
                <option value="project">Project date</option>
                <option value="written">Time of writing</option>
                <option value="reading">Reading time</option>
            </select>
        </label>
        <button
            type="button"
            name="order"
            title="Flip sort direction"
            aria-label="Flip sort direction"
        >
            <span class="tri" aria-hidden="true"></span>
        </button>
    </div>
    <span class="separator" aria-hidden="true">|</span>
    <label>
        Length:
        <select name="reading">
            <option value="">Any</option>
            <option value="0-9">0&ndash;10 min</option>
            <option value="10-30">10&ndash;30 min</option>
            <option value="30-60">30&ndash;60 min</option>
            <option value="60-9999">1h+</option>
        </select>
    </label>
    <label>
        Written:
        <select name="written">
            <option value="">Any year</option>
            {writtenYears.map((year) => <option value={year}>{year}</option>)}
        </select>
    </label>
    <label>
        Project:
        <select name="project">
            <option value="">Any year</option>
            {projectYears.map((year) => <option value={year}>{year}</option>)}
        </select>
    </label>
    <span class="separator" aria-hidden="true">|</span>
    <!--
        Always present, merely disabled while there is nothing to
        clear: popping in and out would shift the row's width and
        with it the tag cloud's wrap boundary.
    -->
    <button
        type="button"
        name="clear"
        class="clear"
        title="Clear filters"
        aria-label="Clear filters"
        disabled
    >
        <span class="cross" aria-hidden="true">&#x2715;</span>
        <span class="clear-label">Clear filters</span>
    </button>
</form>

<script>
    const controls = document.querySelector<HTMLFormElement>('.entry-controls');
    const list = document.querySelector<HTMLUListElement>('.entry-list');
    const noMatches = document.querySelector<HTMLParagraphElement>('.no-matches');

    const sortSelect = controls?.querySelector<HTMLSelectElement>('select[name="sort"]');
    const orderButton = controls?.querySelector<HTMLButtonElement>('button[name="order"]');
    const readingSelect = controls?.querySelector<HTMLSelectElement>('select[name="reading"]');
    const writtenSelect = controls?.querySelector<HTMLSelectElement>('select[name="written"]');
    const projectSelect = controls?.querySelector<HTMLSelectElement>('select[name="project"]');
    const clearButton = controls?.querySelector<HTMLButtonElement>('button[name="clear"]');

    if (controls && list && sortSelect && orderButton && readingSelect && writtenSelect && projectSelect && clearButton) {
        let descending = true;

        const value = (item: HTMLElement, key: string) => Number(item.dataset[key] ?? 0);
        const yearOf = (item: HTMLElement, key: string) => Math.floor(value(item, key) / 12);
        /* the project ran through the year: started by its end, finished no earlier */
        const projectTouches = (item: HTMLElement, year: number) =>
            yearOf(item, 'project') <= year && yearOf(item, 'projectEnd') >= year;

        const activeTagLinks = () => [
            ...document.querySelectorAll<HTMLAnchorElement>('.tag-cloud a.active'),
        ];

        /* filters only — the sort settings aren't the clear button's business */
        const filtersActive = () =>
            readingSelect.value !== '' ||
            writtenSelect.value !== '' ||
            projectSelect.value !== '' ||
            activeTagLinks().length > 0;

        /*
         * The control state lives in the query string, so a filtered
         * view survives a reload and can be shared as a link. Defaults
         * stay out of the URL to keep it clean.
         */
        const syncUrl = () => {
            const params = new URLSearchParams();
            if (sortSelect.value !== 'project') params.set('sort', sortSelect.value);
            if (!descending) params.set('order', 'asc');
            if (readingSelect.value) params.set('length', readingSelect.value);
            if (writtenSelect.value) params.set('written', writtenSelect.value);
            if (projectSelect.value) params.set('project', projectSelect.value);
            const tags = activeTagLinks().map((link) => link.textContent?.trim() ?? '');
            if (tags.length > 0) params.set('tags', tags.join(','));
            const query = params.toString();
            history.replaceState(null, '', query ? `?${query}` : location.pathname);
        };

        /*
         * With a tag selected, every pill shows how many entries the
         * current combination plus that pill would leave, so dead-end
         * combinations announce themselves (zero matches: no count,
         * pill dimmed). With no tag active the cloud stays bare.
         * `pool` holds the tag sets of entries passing the non-tag
         * filters, so the numbers agree with the visible list.
         */
        const updateTagCounts = (pool: string[][], activeTags: string[]) => {
            for (const link of document.querySelectorAll<HTMLAnchorElement>('.tag-cloud a')) {
                if (activeTags.length === 0) {
                    delete link.dataset.count;
                    link.classList.remove('dead');
                    continue;
                }
                const tag = link.textContent?.trim() ?? '';
                const count = pool.filter(
                    (tags) =>
                        tags.includes(tag) &&
                        activeTags.every((active) => tags.includes(active)),
                ).length;
                if (count > 0) {
                    link.dataset.count = String(count);
                    link.classList.remove('dead');
                } else {
                    delete link.dataset.count;
                    link.classList.add('dead');
                }
            }
        };

        const apply = () => {
            const items = [...list.querySelectorAll<HTMLLIElement>(':scope > li')];
            const key = sortSelect.value;
            const direction = descending ? -1 : 1;
            items.sort(
                (a, b) =>
                    direction * (value(a, key) - value(b, key)) ||
                    value(a, 'order') - value(b, 'order'),
            );

            const [min, max] = readingSelect.value
                ? readingSelect.value.split('-').map(Number)
                : [0, Infinity];
            const writtenYear = writtenSelect.value ? Number(writtenSelect.value) : null;
            const projectYear = projectSelect.value ? Number(projectSelect.value) : null;
            const activeTags = activeTagLinks().map((link) => link.textContent?.trim() ?? '');

            let lastVisible: HTMLLIElement | null = null;
            const pool: string[][] = [];
            for (const item of items) {
                list.append(item);
                const reading = value(item, 'reading');
                const itemTags = (item.dataset.tags ?? '').split('|');
                const passesFilters =
                    reading >= min &&
                    reading <= max &&
                    (writtenYear === null || yearOf(item, 'written') === writtenYear) &&
                    (projectYear === null || projectTouches(item, projectYear));
                if (passesFilters) pool.push(itemTags);
                const visible =
                    passesFilters && activeTags.every((tag) => itemTags.includes(tag));
                item.hidden = !visible;
                item.classList.remove('last-visible');
                if (visible) lastVisible = item;
            }
            lastVisible?.classList.add('last-visible');
            if (noMatches) noMatches.hidden = lastVisible !== null;
            updateTagCounts(pool, activeTags);
            clearButton.disabled = !filtersActive();
            syncUrl();
        };

        controls.addEventListener('change', apply);
        orderButton.addEventListener('click', () => {
            descending = !descending;
            orderButton.classList.toggle('ascending', !descending);
            apply();
        });

        clearButton.addEventListener('click', () => {
            readingSelect.value = '';
            writtenSelect.value = '';
            projectSelect.value = '';
            for (const link of activeTagLinks()) link.classList.remove('active');
            apply();
        });

        /*
         * The tag cloud filters in place; the links still lead to the
         * tag pages for new-tab clicks and clients without JS.
         */
        for (const link of document.querySelectorAll<HTMLAnchorElement>('.tag-cloud a')) {
            link.addEventListener('click', (event) => {
                event.preventDefault();
                link.classList.toggle('active');
                apply();
            });
        }

        /*
         * base-select sizes a select's box to the chosen option, not
         * (like native selects) to its widest one — so picking a filter
         * would wiggle the row and, with it, the tag cloud's wrap
         * boundary. Lock every select to its widest option up front.
         * The width lands in a custom property so the phone layout's
         * min-width: 0 can still override it.
         */
        for (const select of [sortSelect, readingSelect, writtenSelect, projectSelect]) {
            const probe = select.cloneNode(true) as HTMLSelectElement;
            probe.style.position = 'absolute';
            probe.style.visibility = 'hidden';
            select.after(probe);
            let widest = 0;
            for (const option of [...probe.options]) {
                probe.value = option.value;
                widest = Math.max(widest, probe.getBoundingClientRect().width);
            }
            probe.remove();
            select.style.setProperty('--widest-option', `${Math.ceil(widest)}px`);
        }

        /* restore any state carried in the URL, then render it */
        const params = new URLSearchParams(location.search);
        const setSelect = (select: HTMLSelectElement, param: string) => {
            const wanted = params.get(param);
            if (wanted && [...select.options].some((option) => option.value === wanted)) {
                select.value = wanted;
            }
        };
        setSelect(sortSelect, 'sort');
        setSelect(readingSelect, 'length');
        setSelect(writtenSelect, 'written');
        setSelect(projectSelect, 'project');
        if (params.get('order') === 'asc') {
            descending = false;
            orderButton.classList.add('ascending');
        }
        const urlTags = params.get('tags')?.split(',') ?? [];
        if (urlTags.length > 0) {
            for (const link of document.querySelectorAll<HTMLAnchorElement>('.tag-cloud a')) {
                if (urlTags.includes(link.textContent?.trim() ?? '')) {
                    link.classList.add('active');
                }
            }
        }
        apply();
    }
</script>

<style>
    .entry-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem 1.25rem;
        margin-top: 1.5rem;
        font-size: 0.9rem;
        color: var(--muted);
    }

    /* same spacing as the form's own gap, so desktop looks unchanged */
    .sort-group {
        display: inline-flex;
        align-items: center;
        gap: 1.25rem;
    }

    .entry-controls label {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        white-space: nowrap;
        font-size: 1rem;
    }

    .entry-controls select {
        /* measured at load; keeps the row's width selection-invariant */
        min-width: var(--widest-option, auto);
        font: inherit;
        font-size: 0.9rem;
        color: var(--fg);
        background: var(--tag-bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        transition: border-color 0.15s ease;
    }

    .entry-controls select:hover,
    .entry-controls select:focus-visible {
        border-color: var(--accent);
    }

    /*
     * Customizable select (Chromium 135+): opt in so the dropdown
     * itself can be styled — rounded, borderless, themed. Browsers
     * without support ignore this and keep their native picker.
     */
    .entry-controls select,
    .entry-controls select::picker(select) {
        appearance: base-select;
    }

    .entry-controls select::picker(select) {
        border: none;
        border-radius: 8px;
        padding: 0.3rem;
        background: var(--tag-bg);
        color: var(--fg);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    }

    /*
     * Chevron in place of the default dropdown triangle. The glyph is
     * two borders of a rotated square, whose point hangs below the box
     * center — the translate before the rotation recenters it.
     */
    .entry-controls select::picker-icon {
        content: '';
        align-self: center;
        width: 0.35em;
        height: 0.35em;
        margin-left: 0.5rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: translateY(-15%) rotate(45deg);
        transition: transform 0.15s ease;
    }

    .entry-controls select:open::picker-icon {
        transform: translateY(20%) rotate(225deg);
    }

    .entry-controls option {
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
        cursor: pointer;
    }

    .entry-controls option:hover,
    .entry-controls option:focus-visible {
        background: var(--border);
    }

    /* triangle in a light outline: clickable, but not a field */
    .entry-controls button {
        /* stretch to the row height so the outline matches the selects */
        align-self: stretch;
        display: inline-flex;
        align-items: center;
        font: inherit;
        font-size: 0.75rem;
        color: var(--muted);
        background: none;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0 0.4rem;
        margin-left: -0.5rem;
        cursor: pointer;
        transition:
            color 0.15s ease,
            border-color 0.15s ease;
    }

    .entry-controls button:hover,
    .entry-controls button:focus-visible {
        color: var(--accent);
        border-color: var(--accent);
    }

    /* compact ✕ on desktop, in the order button's outline style */
    .entry-controls .clear {
        margin-left: 0;
        padding: 0 0.5rem;
        font-size: 0.8rem;
        gap: 0.4rem;
    }

    .entry-controls .clear .clear-label {
        display: none;
    }

    .entry-controls .clear .cross {
        font-weight: 700;
    }

    /* armed: red signals it will discard the current filters */
    .entry-controls .clear:not(:disabled) {
        color: var(--red);
    }

    .entry-controls .clear:not(:disabled):hover,
    .entry-controls .clear:not(:disabled):focus-visible {
        background: color-mix(in srgb, var(--red) 12%, transparent);
        /* the shared row-button hover would turn it accent blue */
        border-color: var(--border);
    }

    /* nothing to clear: dimmed, and inert to the hover accent */
    .entry-controls .clear:disabled {
        color: var(--muted);
        border-color: var(--border);
        opacity: 0.45;
        cursor: default;
    }

    /* filled counterpart of the selects' chevron */
    .entry-controls .tri {
        display: block;
        width: 0.75em;
        height: 0.5em;
        background: currentColor;
        clip-path: polygon(0 0, 100% 0, 50% 100%);
        transition: transform 0.15s ease;
    }

    .entry-controls button.ascending .tri {
        transform: rotate(180deg);
    }

    .separator {
        color: var(--border);
        user-select: none;
    }

    /*
     * Phone view: the four controls in a 2x2 grid — sort | length on
     * the first row, written | project on the second. Labels sit above
     * their selects so the full cell width is available; minmax(0, 1fr)
     * lets the columns shrink so the grid can never outgrow the screen.
     */
    @media (max-width: 640px) {
        .entry-controls {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 0.85rem 1rem;
        }

        .separator {
            display: none;
        }

        .entry-controls label {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 0.35rem;
            min-width: 0;
            white-space: normal;
            font-size: 0.9rem;
        }

        .entry-controls select {
            width: 100%;
            min-width: 0;
            height: 2rem;
            /* the label allows wrapping; the select's value must not */
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sort-group {
            display: flex;
            align-items: flex-end;
            gap: 0.5rem;
            min-width: 0;
        }

        .sort-group label {
            flex: 1;
        }

        .entry-controls button {
            align-self: flex-end;
            height: 2rem;
            margin-left: 0;
        }

        /* its own line below the 2x2 filter grid, with the full label */
        .entry-controls .clear {
            grid-column: 1 / -1;
            justify-self: start;
            font-size: 0.9rem;
            padding: 0.25rem 0.6rem;
        }

        /* text only on phone: label in, ✕ out */
        .entry-controls .clear .clear-label {
            display: inline;
        }

        .entry-controls .clear .cross {
            display: none;
        }

        /* armed on phone: the label lights up (fg is white-ish in dark
           mode; literal #fff would vanish on the light theme) */
        .entry-controls .clear:not(:disabled) {
            color: var(--fg);
        }
    }
</style>
