---
interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Luca's Journal"
            href={new URL('rss.xml', Astro.site)}
        />
        <link
            rel="alternate"
            type="application/atom+xml"
            title="Luca's Journal (Atom)"
            href={new URL('atom.xml', Astro.site)}
        />
    </head>
    <body>
        <header>
            <nav>
                <a href="/" class="site-title">Home</a>
                <a href="/entries/" class="nav-link">Entries</a>
                <div class="nav-links">
                    <a
                        href="mailto:luca.goddijn@gmail.com"
                        class="icon-link"
                        aria-label="Email"
                        title="Email"
                    >
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
                            <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
                        </svg>
                    </a>
                    <a
                        href="https://github.com/Arty3"
                        class="icon-link"
                        aria-label="GitHub"
                        title="GitHub"
                        target="_blank"
                        rel="noopener"
                    >
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                        </svg>
                    </a>
                    <a
                        href="https://www.linkedin.com/in/luca-goddijn/"
                        class="icon-link"
                        aria-label="LinkedIn"
                        title="LinkedIn"
                        target="_blank"
                        rel="noopener"
                    >
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z" />
                        </svg>
                    </a>
                    <a
                        href="/rss.xml"
                        class="icon-link"
                        aria-label="RSS feed"
                        title="RSS feed"
                    >
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M3.75 3.5a1.25 1.25 0 0 0 0 2.5c7.87 0 14.25 6.38 14.25 14.25a1.25 1.25 0 0 0 2.5 0C20.5 11 13 3.5 3.75 3.5Z" />
                            <path d="M3.75 10a1.25 1.25 0 0 0 0 2.5 7.75 7.75 0 0 1 7.75 7.75 1.25 1.25 0 0 0 2.5 0C14 14.59 9.41 10 3.75 10Z" />
                            <circle cx="5.25" cy="18.75" r="2.25" />
                        </svg>
                    </a>
                </div>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer>
            <p>
                Content licensed under <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>, code under MIT.
            </p>
        </footer>
    </body>
</html>

<style is:global>
    :root {
        --bg: #fdfdfc;
        --fg: #1c1c1a;
        --muted: #6b6b66;
        --accent: #2c5aa0;
        --green: #16a34a;
        --border: #e4e4e0;
        --tag-bg: #f0f0ec;
        color-scheme: light dark;
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --bg: #16161a;
            --fg: #e6e6e2;
            --muted: #97978f;
            --accent: #8ab4e8;
            --green: #4cc273;
            --border: #2c2c32;
            --tag-bg: #24242a;
        }
    }

    * {
        box-sizing: border-box;
    }

    html {
        /* the layout is responsive; don't let mobile browsers inflate text */
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
        /*
         * Reserve the scrollbar gutter: filtering the entry list can
         * make the page short enough to lose the scrollbar, which
         * would otherwise shift the whole layout sideways.
         */
        scrollbar-gutter: stable;
    }

    body {
        margin: 0 auto;
        padding: 0 2rem;
        /*
         * Wide but not edge-to-edge: the column tracks the viewport,
         * leaving a modest gutter on large monitors (caps at 100rem).
         * Never wider than the viewport itself on small screens.
         */
        max-width: min(100%, clamp(60rem, 30rem + 60vw, 100rem));
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        font-size: 1.2rem;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
    }

    header nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 2rem;
        padding: 1.75rem 0 1.25rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 3rem;
    }

    .site-title,
    .nav-link {
        position: relative;
        font-weight: 700;
        font-size: 1.45rem;
        color: var(--accent);
        text-decoration: none;
    }

    .site-title::after,
    .nav-link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -0.2rem;
        width: 100%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.2s ease;
    }

    .site-title:hover::after,
    .nav-link:hover::after {
        transform: scaleX(1);
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        margin-left: auto;
    }

    .icon-link {
        display: inline-flex;
        align-items: center;
        color: var(--muted);
        transition: color 0.15s ease;
    }

    .icon-link:hover {
        color: var(--accent);
    }

    .icon-link svg {
        width: 1.55rem;
        height: 1.55rem;
    }

    main a {
        color: var(--accent);
    }

    h1,
    h2,
    h3 {
        line-height: 1.25;
    }

    h1 {
        font-size: 2.5rem;
        margin-top: 0;
    }

    h2 {
        font-size: 1.75rem;
        margin-top: 2.5rem;
    }

    h3 {
        font-size: 1.35rem;
    }

    code {
        font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
        font-size: 0.95em;
        background: var(--tag-bg);
        padding: 0.1em 0.35em;
        border-radius: 4px;
        tab-size: 4;
    }

    pre {
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 0.95em;
        tab-size: 4;
    }

    pre code {
        background: none;
        padding: 0;
    }

    pre.mermaid {
        display: flex;
        justify-content: center;
        background: none;
        overflow-x: auto;
    }

    iframe[src*='google.com/maps/embed'] {
        display: block;
        width: 100%;
        height: min(70vh, 45rem);
        margin: 1.5rem 0;
        border-radius: 8px;
    }

    .pdf-embed {
        display: block;
        width: 100%;
        height: min(80vh, 60rem);
        margin: 1.5rem 0;
        border: 1px solid var(--border);
        border-radius: 8px;
    }

    blockquote {
        margin: 1rem 0;
        padding-left: 1rem;
        border-left: 3px solid var(--border);
        color: var(--fg);
    }

    .markdown-alert {
        --alert-color: var(--accent);
        margin: 1rem 0;
        padding: 0.5rem 1rem;
        border-left: 3px solid var(--alert-color);
    }

    .markdown-alert > :last-child {
        margin-bottom: 0;
    }

    .markdown-alert-title {
        margin: 0 0 0.25rem;
        font-weight: 600;
        color: var(--alert-color);
        text-transform: lowercase;
        font-variant: small-caps;
        letter-spacing: 0.02em;
    }

    .markdown-alert-title .octicon {
        fill: currentColor;
        vertical-align: text-bottom;
        margin-right: 0.4rem;
    }

    .markdown-alert-note {
        --alert-color: var(--accent);
    }

    .markdown-alert-tip {
        --alert-color: var(--green);
    }

    .markdown-alert-important {
        --alert-color: #8250df;
    }

    .markdown-alert-warning {
        --alert-color: #9a6700;
    }

    .markdown-alert-caution {
        --alert-color: #cf222e;
    }

    @media (prefers-color-scheme: dark) {
        .markdown-alert-important {
            --alert-color: #a371f7;
        }

        .markdown-alert-warning {
            --alert-color: #d29922;
        }

        .markdown-alert-caution {
            --alert-color: #f85149;
        }
    }

    img {
        max-width: 100%;
        height: auto;
    }

    hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2rem 0;
    }

    table {
        border-collapse: collapse;
        width: 100%;
    }

    th,
    td {
        border: 1px solid var(--border);
        padding: 0.4rem 0.6rem;
        text-align: left;
    }

    /*
     * Comparison tables place one screenshot per cell; stretch each
     * to its cell so side-by-side images share the same scale, and
     * keep the table itself narrower than the full column.
     */
    td img {
        display: block;
        width: 100%;
    }

    table:has(td img) {
        width: 75%;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        padding: 0;
        list-style: none;
        margin: 0.5rem 0 0;
    }

    .tags a {
        display: inline-block;
        /*
         * --tag-hue is computed at build time from tag-word semantics
         * (src/lib/tagColors.ts): related tags get neighboring hues.
         * The saturation is kept low so the pills stay understated;
         * hover and selection stay in the tag's own hue, only more
         * vivid.
         */
        background: hsl(var(--tag-hue, 220) 30% 91%);
        color: hsl(var(--tag-hue, 220) 30% 34%);
        border-radius: 999px;
        padding: 0.1rem 0.65rem;
        font-size: 0.8rem;
        text-decoration: none;
        transition:
            background-color 0.15s ease,
            color 0.15s ease,
            box-shadow 0.15s ease;
    }

    .tags a:hover {
        background: hsl(var(--tag-hue, 220) 75% 84%);
        color: hsl(var(--tag-hue, 220) 85% 24%);
    }

    /* selected as filter (entries page) or the current tag page */
    .tags a.active,
    .tags a[aria-current='page'] {
        background: hsl(var(--tag-hue, 220) 90% 80%);
        color: hsl(var(--tag-hue, 220) 100% 12%);
    }

    @media (prefers-color-scheme: dark) {
        .tags a {
            background: hsl(var(--tag-hue, 220) 22% 21%);
            color: hsl(var(--tag-hue, 220) 35% 74%);
        }

        .tags a:hover {
            background: hsl(var(--tag-hue, 220) 60% 32%);
            color: hsl(var(--tag-hue, 220) 95% 82%);
        }

        .tags a.active,
        .tags a[aria-current='page'] {
            background: hsl(var(--tag-hue, 220) 80% 38%);
            color: hsl(var(--tag-hue, 220) 100% 96%);
        }
    }

    /* plain muted text, no pill chrome */
    .reading-time {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.5rem;
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
        transition: color 0.15s ease;
    }

    .reading-time svg {
        width: 0.95em;
        height: 0.95em;
    }

    footer {
        margin-top: 4rem;
        padding: 1.5rem 0;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.85rem;
    }

    footer a {
        color: inherit;
    }

    /* wide display math scrolls within its own box, not the page */
    .katex-display {
        overflow-x: auto;
        overflow-y: hidden;
    }

    @media (max-width: 640px) {
        body {
            padding: 0 1.25rem;
            font-size: 1.05rem;
        }

        header nav {
            gap: 1.25rem;
            padding-top: 1.25rem;
            margin-bottom: 2rem;
        }

        .site-title,
        .nav-link {
            font-size: 1.25rem;
        }

        h1 {
            font-size: 2rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        table {
            display: block;
            overflow-x: auto;
        }

        /* the narrow column needs every pixel; undo the desktop shrink */
        table:has(td img) {
            width: 100%;
        }

        /*
         * Entries size images with percentage width attributes meant
         * for the wide desktop column; on phones let them fill it.
         */
        main img[width] {
            width: 100%;
        }
    }
</style>
