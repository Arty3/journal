---
/* IBM Plex Serif, a screen-first text serif, for all prose: the weights the
   site uses (regular, semibold, bold) and the italics it sets in them */
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/400-italic.css';
import '@fontsource/ibm-plex-serif/600.css';
import '@fontsource/ibm-plex-serif/700.css';
import '@fontsource/ibm-plex-serif/700-italic.css';

interface Props {
    title: string;
    description?: string;
    /** Social-preview image path; defaults to the site icon card. */
    image?: string;
}

const { title, description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);
/* the copyright years in the footer: the journal's first year, then a
   range once the build year moves past it (the site rebuilds on push) */
const firstYear = 2026;
const buildYear = new Date().getFullYear();
const copyrightYears = buildYear > firstYear ? `${firstYear}–${buildYear}` : `${firstYear}`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="author" content="Luca Goddijn" />
        <meta name="theme-color" content="#16161a" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <!-- iOS ignores SVG favicons for home-screen and tab icons -->
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:site_name" content="Luca's Journal" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Luca's Journal"
            href={new URL('rss.xml', Astro.site)}
        />
        <link
            rel="alternate"
            type="application/atom+xml"
            title="Luca's Journal (Atom)"
            href={new URL('atom.xml', Astro.site)}
        />
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to content</a>
        <header>
            <nav>
                <a href="/" class="site-title" aria-label="Luca's Journal, home">
                    <!-- the mark, same drawing as /favicon.svg: a ring-bound notebook
                         with a bookmark ribbon -->
                    <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
                        <rect width="64" height="64" rx="14" fill="#2c5aa0" />
                        <rect x="17" y="11" width="32" height="42" rx="4" fill="#fdfdfc" />
                        <g fill="#2c5aa0" stroke="#fdfdfc" stroke-width="2">
                            <circle cx="17" cy="19" r="3" />
                            <circle cx="17" cy="32" r="3" />
                            <circle cx="17" cy="45" r="3" />
                        </g>
                        <g fill="#2c5aa0">
                            <rect x="26" y="25" width="16" height="3" rx="1.5" />
                            <rect x="26" y="33" width="16" height="3" rx="1.5" />
                            <rect x="26" y="41" width="10" height="3" rx="1.5" />
                        </g>
                        <polygon
                            points="40,11 46,11 46,22 43,19 40,22"
                            fill="#2c5aa0"
                            opacity="0.7"
                        />
                    </svg>
                    <span>Luca's Journal</span>
                </a>
                <div class="nav-pages">
                    <a href="/entries/" class="nav-link">Entries</a>
                    <a href="/#what-this-is" class="nav-link">About</a>
                </div>
                <div class="nav-links">
                    <a href="/#subscribe" class="icon-link" aria-label="Subscribe" title="Subscribe">
                        <!-- a bell, as on the subscribe box itself -->
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2.25a6.75 6.75 0 0 0-6.75 6.75v3.6c0 .54-.16 1.07-.46 1.52L3.3 16.4a1.25 1.25 0 0 0 1.04 1.95h15.32a1.25 1.25 0 0 0 1.04-1.95l-1.49-2.28a2.75 2.75 0 0 1-.46-1.52V9A6.75 6.75 0 0 0 12 2.25Z" />
                            <path d="M9.25 19.5a2.75 2.75 0 0 0 5.5 0h-5.5Z" />
                        </svg>
                    </a>
                    <a
                        href="mailto:luca.goddijn@gmail.com"
                        class="icon-link"
                        aria-label="Email"
                        title="Email"
                    >
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
                            <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
                        </svg>
                    </a>
                    <a
                        href="https://github.com/Arty3"
                        class="icon-link"
                        aria-label="GitHub"
                        title="GitHub"
                        target="_blank"
                        rel="noopener"
                    >
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                        </svg>
                    </a>
                    <a
                        href="https://www.linkedin.com/in/luca-goddijn/"
                        class="icon-link icon-link-linkedin"
                        aria-label="LinkedIn"
                        title="LinkedIn"
                        target="_blank"
                        rel="noopener"
                    >
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z" />
                        </svg>
                    </a>
                    <a
                        href="/rss.xml"
                        class="icon-link"
                        aria-label="RSS feed"
                        title="RSS feed"
                    >
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M3.75 3.5a1.25 1.25 0 0 0 0 2.5c7.87 0 14.25 6.38 14.25 14.25a1.25 1.25 0 0 0 2.5 0C20.5 11 13 3.5 3.75 3.5Z" />
                            <path d="M3.75 10a1.25 1.25 0 0 0 0 2.5 7.75 7.75 0 0 1 7.75 7.75 1.25 1.25 0 0 0 2.5 0C14 14.59 9.41 10 3.75 10Z" />
                            <circle cx="5.25" cy="18.75" r="2.25" />
                        </svg>
                    </a>
                </div>
            </nav>
        </header>
        <main id="main-content">
            <slot />
        </main>
        <footer>
            <p>
                &copy; {copyrightYears} Luca Goddijn. Content licensed under <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>, code under <a href="https://github.com/Arty3/journal/blob/main/LICENSE">MIT</a>.
            </p>
        </footer>
    </body>
</html>

<style is:global>
    /* the site is deliberately dark-only, whatever the OS prefers */
    :root {
        --bg: #16161a;
        --fg: #e6e6e2;
        --muted: #97978f;
        --accent: #8ab4e8;
        --green: #4cc273;
        --red: #f85149;
        --border: #2c2c32;
        --tag-bg: #24242a;
        /* prose reads in a serif; controls, labels and code keep the
           original sans and mono stacks */
        --font-serif: 'IBM Plex Serif', Georgia, 'Times New Roman', serif;
        --font-ui: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        --font-mono: ui-monospace, 'Cascadia Code', Consolas, monospace;
        color-scheme: dark;
    }

    * {
        box-sizing: border-box;
    }

    html {
        /* the layout is responsive; don't let mobile browsers inflate text */
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
        /*
         * Reserve the scrollbar gutter: filtering the entry list can
         * make the page short enough to lose the scrollbar, which
         * would otherwise shift the whole layout sideways.
         */
        scrollbar-gutter: stable;
        /* anchor and skip-link jumps glide (reduced-motion undoes this) */
        scroll-behavior: smooth;
    }

    body {
        margin: 0 auto;
        padding: 0 2rem;
        /*
         * Wide but not edge-to-edge: the column tracks the viewport,
         * leaving a modest gutter on large monitors (caps at 100rem).
         * Never wider than the viewport itself on small screens.
         */
        max-width: min(100%, clamp(60rem, 30rem + 60vw, 100rem));
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-serif);
        font-size: 1.2rem;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
    }

    header nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 2rem;
        padding: 1.75rem 0 1.25rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 3rem;
    }

    .site-title,
    .nav-link {
        position: relative;
        font-weight: 700;
        font-size: 1.45rem;
        color: var(--accent);
        text-decoration: none;
    }

    /* the page links take the UI face; only the journal's name stays serif */
    .nav-link {
        font-family: var(--font-ui);
    }

    /* the journal's mark and name: plain until hovered, then the same
       underline and accent as the page links */
    .site-title {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        /* a step up from the page links so the name reads as the masthead */
        font-size: 1.75rem;
        color: var(--fg);
        transition: color 0.15s ease;
    }

    .site-title .mark {
        width: 1.9rem;
        height: 1.9rem;
        flex: none;
        transition: transform 0.2s ease;
    }

    .site-title span {
        position: relative;
    }

    .site-title:hover,
    .site-title:focus-visible {
        color: var(--accent);
    }

    /* the mark tilts a little along with the underline */
    .site-title:hover .mark,
    .site-title:focus-visible .mark {
        transform: rotate(-6deg);
    }

    .site-title span::after,
    .nav-link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -0.2rem;
        width: 100%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.2s ease;
    }

    .site-title:hover span::after,
    .site-title:focus-visible span::after,
    .nav-link:hover::after,
    .nav-link:focus-visible::after {
        transform: scaleX(1);
    }

    /* the page links and the icons sit together on the right */
    .nav-pages {
        display: flex;
        align-items: center;
        gap: 2rem;
        margin-left: auto;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 1.1rem;
    }

    .icon-link {
        display: inline-flex;
        align-items: center;
        color: var(--muted);
        transition: color 0.15s ease;
    }

    .icon-link:hover,
    .icon-link:focus-visible {
        color: var(--accent);
    }

    .icon-link svg {
        width: 1.75rem;
        height: 1.75rem;
    }

    /* the LinkedIn glyph fills its box edge to edge, unlike the others,
       so it is drawn a little smaller to look the same size */
    .icon-link-linkedin svg {
        width: 1.5rem;
        height: 1.5rem;
    }

    main a {
        color: var(--accent);
    }

    /* hidden until keyboard focus, then pinned to the top-left corner */
    .skip-link {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 10;
        padding: 0.5rem 1rem;
        background: var(--accent);
        color: var(--bg);
        text-decoration: none;
        font-weight: 700;
        border-radius: 0 0 8px 0;
        transform: translateY(-150%);
        transition: transform 0.15s ease;
    }

    .skip-link:focus-visible {
        transform: none;
    }

    h1,
    h2,
    h3 {
        line-height: 1.25;
        /* no headline wrapping into a line and a dangling word */
        text-wrap: balance;
    }

    p {
        text-wrap: pretty;
    }

    h1 {
        font-size: 2.5rem;
        margin-top: 0;
    }

    h2 {
        font-size: 1.75rem;
        margin-top: 2.5rem;
    }

    h3 {
        font-size: 1.35rem;
    }

    code {
        font-family: var(--font-mono);
        font-size: 0.95em;
        background: var(--tag-bg);
        padding: 0.1em 0.35em;
        border-radius: 4px;
        tab-size: 4;
    }

    pre {
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 0.95em;
        tab-size: 4;
    }

    pre code {
        background: none;
        padding: 0;
    }

    pre.mermaid {
        display: flex;
        justify-content: center;
        background: none;
        overflow-x: auto;
    }

    iframe[src*='google.com/maps/embed'] {
        display: block;
        width: 100%;
        height: min(70vh, 45rem);
        margin: 1.5rem 0;
        border-radius: 8px;
    }

    .pdf-embed {
        display: block;
        width: 100%;
        height: min(80vh, 60rem);
        margin: 1.5rem 0;
        border: 1px solid var(--border);
        border-radius: 8px;
    }

    blockquote {
        margin: 1rem 0;
        padding-left: 1rem;
        border-left: 3px solid var(--border);
        color: var(--fg);
    }

    .markdown-alert {
        --alert-color: var(--accent);
        margin: 1rem 0;
        padding: 0.5rem 1rem;
        border-left: 3px solid var(--alert-color);
    }

    .markdown-alert > :last-child {
        margin-bottom: 0;
    }

    .markdown-alert-title {
        margin: 0 0 0.25rem;
        font-weight: 600;
        color: var(--alert-color);
        text-transform: lowercase;
        font-variant: small-caps;
        letter-spacing: 0.02em;
    }

    .markdown-alert-title .octicon {
        fill: currentColor;
        vertical-align: text-bottom;
        margin-right: 0.4rem;
    }

    .markdown-alert-note {
        --alert-color: var(--accent);
    }

    .markdown-alert-tip {
        --alert-color: var(--green);
    }

    .markdown-alert-important {
        --alert-color: #a371f7;
    }

    .markdown-alert-warning {
        --alert-color: #d29922;
    }

    .markdown-alert-caution {
        --alert-color: #f85149;
    }

    img {
        max-width: 100%;
        height: auto;
    }

    hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2rem 0;
    }

    table {
        border-collapse: collapse;
        width: 100%;
    }

    th,
    td {
        border: 1px solid var(--border);
        padding: 0.4rem 0.6rem;
        text-align: left;
    }

    /*
     * Comparison tables place one screenshot per cell; stretch each
     * to its cell so side-by-side images share the same scale, and
     * keep the table itself narrower than the full column.
     */
    td img {
        display: block;
        width: 100%;
    }

    table:has(td img) {
        width: 75%;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        padding: 0;
        list-style: none;
        margin: 0.5rem 0 0;
    }

    .tags a {
        display: inline-block;
        font-family: var(--font-ui);
        /*
         * --tag-hue is computed at build time from tag-word semantics
         * (src/lib/tagColors.ts): related tags get neighboring hues.
         * Each pill is a tinted fill with an outline in its own hue;
         * hover and selection stay in that hue, only more vivid.
         */
        background: hsl(var(--tag-hue, 220) 30% 22% / 0.55);
        color: hsl(var(--tag-hue, 220) 45% 78%);
        border: 1px solid hsl(var(--tag-hue, 220) 30% 38% / 0.8);
        border-radius: 999px;
        padding: 0.1rem 0.65rem;
        font-size: 0.8rem;
        text-decoration: none;
        transition:
            background-color 0.15s ease,
            color 0.15s ease,
            border-color 0.15s ease;
    }

    .tags a:hover,
    .tags a:focus-visible {
        background: hsl(var(--tag-hue, 220) 60% 40%);
        color: hsl(var(--tag-hue, 220) 100% 94%);
        border-color: transparent;
    }

    /* selected as filter (entries page) or the current tag page */
    .tags a.active,
    .tags a[aria-current='page'] {
        background: hsl(var(--tag-hue, 220) 60% 40%);
        color: hsl(var(--tag-hue, 220) 100% 94%);
        border-color: transparent;
    }

    /* project status: a coloured dot and a small label */
    .status {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-family: var(--font-ui);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
        white-space: nowrap;
    }

    .status {
        --status-color: var(--muted);
    }

    .status::before {
        content: '';
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--status-color);
        flex: none;
        transition: box-shadow 0.15s ease;
    }

    .status-completed {
        --status-color: var(--green);
    }

    .status-abandoned {
        --status-color: #e0877a;
    }

    .status-ongoing {
        --status-color: var(--accent);
    }

    /* ongoing glows all the time; the others only glow on card hover in
       entry lists (see EntryList), never on the entry page itself */
    .status-ongoing::before {
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--status-color) 25%, transparent);
    }

    /* plain muted text, no pill chrome */
    .reading-time {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.5rem;
        font-family: var(--font-ui);
        color: var(--muted);
        font-size: 0.85rem;
        white-space: nowrap;
        transition: color 0.15s ease;
    }

    .reading-time svg {
        width: 0.95em;
        height: 0.95em;
    }

    /* the sort and filter strip keeps its original sans face */
    .entry-controls {
        font-family: var(--font-ui);
    }

    footer {
        margin-top: 4rem;
        padding: 1.5rem 0;
        border-top: 1px solid var(--border);
        font-family: var(--font-ui);
        color: var(--muted);
        font-size: 0.85rem;
    }

    footer a {
        color: inherit;
    }

    /*
     * The '#' appended to entry headings by rehype-autolink-headings:
     * invisible until the heading is hovered (or the anchor itself is
     * focused), so long entries can be deep-linked per section.
     */
    .heading-anchor {
        margin-left: 0.45em;
        color: var(--muted);
        text-decoration: none;
        opacity: 0;
        transition: opacity 0.15s ease;
    }

    :is(h1, h2, h3, h4, h5, h6):hover .heading-anchor,
    .heading-anchor:focus-visible,
    /* touch devices can't hover: a tap on the heading toggles this
       class instead (script in the entry page) */
    .show-anchor .heading-anchor {
        opacity: 1;
    }

    .heading-anchor:hover,
    .heading-anchor:focus-visible {
        color: var(--accent);
    }

    /* a little air above a heading jumped to via its anchor */
    :is(h1, h2, h3, h4, h5, h6)[id] {
        scroll-margin-top: 1rem;
    }

    /* wide display math scrolls within its own box, not the page;
       vertical padding keeps overflow-y from clipping tall glyphs
       (superscripts, fraction numerators) whose ink extends slightly
       past KaTeX's computed line box */
    .katex-display {
        overflow-x: auto;
        overflow-y: hidden;
        padding-block: 0.25em;
    }

    /*
     * Collapse every transition and animation for readers who ask for
     * reduced motion — state changes still happen, just instantly.
     */
    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            transition-duration: 0.01ms !important;
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            scroll-behavior: auto !important;
        }
    }

    @media (max-width: 640px) {
        body {
            padding: 0 1.25rem;
            font-size: 1.05rem;
        }

        /* a fixed two-row grid: the name alone on top, then the page links
           on the left and the icons on the right of the row beneath it,
           whatever the screen width */
        header nav {
            display: grid;
            grid-template-columns: auto 1fr;
            row-gap: 1.25rem;
            column-gap: 1rem;
            padding-top: 1.25rem;
            margin-bottom: 2rem;
        }

        .site-title {
            grid-column: 1 / -1;
            font-size: 1.5rem;
        }

        .nav-pages {
            gap: 1rem;
            margin-left: 0;
        }

        .nav-link {
            font-size: 1.15rem;
        }

        .nav-links {
            gap: 0.7rem;
            justify-self: end;
        }

        .icon-link svg {
            width: 1.5rem;
            height: 1.5rem;
        }

        .icon-link-linkedin svg {
            width: 1.25rem;
            height: 1.25rem;
        }

        h1 {
            font-size: 2rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        table {
            display: block;
            overflow-x: auto;
