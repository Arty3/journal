---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readingTime, sortedEntries, visibleStatus } from '../../lib/entries';
import { allTagHues } from '../../lib/tagColors';

export async function getStaticPaths() {
    const entries = await sortedEntries();
    return entries.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const tagHues = await allTagHues();
/* same spectrum order as the tag cloud */
const orderedTags = [...entry.data.tags].sort(
    (a, b) => (tagHues.get(a) ?? 0) - (tagHues.get(b) ?? 0),
);
---

<Base
    title={`${entry.data.title} - Luca's Journal - ${readingTime(entry)} min`}
    description={entry.data.description}
>
    <article>
        <header>
            <h1>{entry.data.title}</h1>
            <p class="description">{entry.data.description}</p>
            {
                (entry.data.project || entry.data.written || visibleStatus(entry)) && (
                    <p class="meta">
                        {[
                            entry.data.project &&
                                `Developed during ${entry.data.project}`,
                            entry.data.written && `Written ${entry.data.written}`,
                            visibleStatus(entry),
                        ]
                            .filter(Boolean)
                            .join(' · ')}
                    </p>
                )
            }
            {
                entry.data.tags.length > 0 && (
                    <ul class="tags">
                        {orderedTags.map((tag) => (
                            <li>
                                <a
                                    href={`/tags/${tag}/`}
                                    style={`--tag-hue: ${tagHues.get(tag)}`}
                                >
                                    {tag}
                                </a>
                            </li>
                        ))}
                    </ul>
                )
            }
            <span class="reading-time">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
                {readingTime(entry)} min
            </span>
            <p class="back">
                <a href="/entries/">&larr; All entries</a>
            </p>
        </header>
        <Content />
    </article>
    <dialog class="lightbox" aria-label="Full screen image">
        <img src="" alt="" />
    </dialog>
</Base>

<script>
    const blocks = document.querySelectorAll('pre > code.language-mermaid');

    if (blocks.length > 0) {
        const { default: mermaid } = await import('mermaid');

        mermaid.initialize({
            startOnLoad: false,
            theme: window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'default',
            fontFamily:
                "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
        });

        for (const code of blocks) {
            const pre = code.parentElement;
            if (!pre) continue;
            const container = document.createElement('pre');
            container.className = 'mermaid';
            container.textContent = code.textContent ?? '';
            pre.replaceWith(container);
        }

        await mermaid.run({ querySelector: 'pre.mermaid' });
    }
</script>

<script>
    /* same grow-and-lightbox behavior as the home page photos */
    const lightbox = document.querySelector<HTMLDialogElement>('.lightbox');
    const lightboxImg = lightbox?.querySelector('img');

    if (lightbox && lightboxImg) {
        for (const img of document.querySelectorAll<HTMLImageElement>('article img')) {
            /* linked images keep their link behavior */
            if (img.closest('a')) continue;
            img.classList.add('zoomable');
            img.addEventListener('click', () => {
                lightboxImg.src = img.src;
                lightboxImg.alt = img.alt;
                lightbox.showModal();
            });
        }

        /* click anywhere (image or backdrop) closes; Esc works natively */
        lightbox.addEventListener('click', () => lightbox.close());
    }
</script>

<style>
    article > header {
        margin-bottom: 2.5rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--border);
    }

    .description {
        color: var(--muted);
        margin: 0.5rem 0 0;
    }

    .meta {
        color: var(--muted);
        font-size: 0.9rem;
        margin: 0.6rem 0 0;
    }

    .reading-time {
        margin-top: 0.75rem;
    }

    .back {
        margin: 1.5rem 0 0;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .back a {
        position: relative;
        text-decoration: none;
    }

    .back a::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -0.2rem;
        width: 100%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.2s ease;
    }

    .back a:hover::after {
        transform: scaleX(1);
    }

    /* markdown content isn't scoped, hence the :global() */
    article :global(img.zoomable) {
        cursor: zoom-in;
        transition: transform 0.25s ease;
    }

    article :global(img.zoomable:hover) {
        transform: scale(1.03);
    }

    .lightbox {
        padding: 0;
        border: none;
        background: transparent;
        max-width: 92vw;
        max-height: 92vh;
        cursor: zoom-out;
        /* the dialog receives focus on open; its ring frames the screen */
        outline: none;
    }

    .lightbox::backdrop {
        background: rgba(0, 0, 0, 0.85);
    }

    .lightbox img {
        display: block;
        /* fixed viewport-sized box: contain scales any aspect ratio
           up or down to fill it, so wide images open large too */
        width: 92vw;
        height: 92vh;
        object-fit: contain;
    }
</style>
