---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readingTimeLabel, sortedEntries, visibleStatus } from '../../lib/entries';
import { allTagHues } from '../../lib/tagColors';

export async function getStaticPaths() {
    const entries = await sortedEntries();
    return entries.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const tagHues = await allTagHues();
/* same spectrum order as the tag cloud */
const orderedTags = [...entry.data.tags].sort(
    (a, b) => (tagHues.get(a) ?? 0) - (tagHues.get(b) ?? 0),
);
---

<Base
    title={`${entry.data.title} - Luca's Journal - ${readingTimeLabel(entry)}`}
    description={entry.data.description}
    image={entry.data.ogImage}
>
    <article>
        <header>
            <h1>{entry.data.title}</h1>
            <p class="description">{entry.data.description}</p>
            {
                (entry.data.project || entry.data.written || visibleStatus(entry)) && (
                    <p class="meta">
                        {[
                            entry.data.project &&
                                `Developed during ${entry.data.project}`,
                            entry.data.written && `Written ${entry.data.written}`,
                            visibleStatus(entry),
                        ]
                            .filter(Boolean)
                            .join(' · ')}
                    </p>
                )
            }
            {
                entry.data.tags.length > 0 && (
                    <ul class="tags">
                        {orderedTags.map((tag) => (
                            <li>
                                <a
                                    href={`/tags/${tag}/`}
                                    style={`--tag-hue: ${tagHues.get(tag)}`}
                                >
                                    {tag}
                                </a>
                            </li>
                        ))}
                    </ul>
                )
            }
            <span class="reading-time">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
                {readingTimeLabel(entry)}
            </span>
            <p class="back">
                <a href="/entries/">&larr; All entries</a>
            </p>
        </header>
        <Content />
        <p class="back back-bottom">
            <a href="/entries/">&larr; All entries</a>
        </p>
    </article>
    <dialog class="lightbox" aria-label="Full screen image">
        <img src="" alt="" />
    </dialog>
</Base>

<script>
    const blocks = document.querySelectorAll('pre > code.language-mermaid');

    if (blocks.length > 0) {
        const { default: mermaid } = await import('mermaid');

        mermaid.initialize({
            startOnLoad: false,
            /* the site is dark-only */
            theme: 'dark',
            fontFamily:
                "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
        });

        for (const code of blocks) {
            const pre = code.parentElement;
            if (!pre) continue;
            const container = document.createElement('pre');
            container.className = 'mermaid';
            container.textContent = code.textContent ?? '';
            pre.replaceWith(container);
        }

        await mermaid.run({ querySelector: 'pre.mermaid' });
    }
</script>

<script>
    /*
     * Touch devices have no hover, so the heading anchors would never
     * show: there, tapping a heading toggles its anchor instead. The
     * anchor itself still navigates. Hover devices are left alone.
     */
    if (window.matchMedia('(hover: none)').matches) {
        for (const heading of document.querySelectorAll(
            'article :is(h1, h2, h3, h4, h5, h6):has(.heading-anchor)',
        )) {
            heading.addEventListener('click', (event) => {
                if ((event.target as HTMLElement).closest('.heading-anchor')) return;
                heading.classList.toggle('show-anchor');
            });
        }
    }
</script>

<script>
    /*
     * A copy button in the corner of every code block (mermaid sources
     * excluded — they become diagrams). The block is wrapped so the
     * button stays pinned while the code scrolls sideways beneath it.
     * Same icon pair and copied-feedback as the feed-URL button.
     */
    const COPY_ICON = `<svg class="copy" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"/><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/></svg>`;
    const CHECK_ICON = `<svg class="check" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg>`;

    for (const code of document.querySelectorAll<HTMLElement>(
        'article pre > code:not(.language-mermaid)',
    )) {
        const pre = code.parentElement;
        if (!pre) continue;
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        pre.replaceWith(wrapper);
        wrapper.append(pre);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-code';
        button.title = 'Copy code';
        button.setAttribute('aria-label', 'Copy code');
        button.innerHTML = COPY_ICON + CHECK_ICON;
        wrapper.append(button);

        button.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(code.innerText);
            } catch {
                return;
            }
            button.classList.add('copied');
            setTimeout(() => button.classList.remove('copied'), 1500);
        });
    }
</script>

<script>
    /* same grow-and-lightbox behavior as the home page photos */
    const lightbox = document.querySelector<HTMLDialogElement>('.lightbox');
    const lightboxImg = lightbox?.querySelector('img');

    if (lightbox && lightboxImg) {
        for (const img of document.querySelectorAll<HTMLImageElement>('article img')) {
            /* linked images keep their link behavior */
            if (img.closest('a')) continue;
            img.classList.add('zoomable');
            img.addEventListener('click', () => {
                lightboxImg.src = img.src;
                lightboxImg.alt = img.alt;
                lightbox.showModal();
            });
        }

        /* click anywhere (image or backdrop) closes; Esc works natively */
        lightbox.addEventListener('click', () => lightbox.close());
    }
</script>

<style>
    article > header {
        margin-bottom: 2.5rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--border);
    }

    article > header h1 {
        margin-bottom: 0;
    }

    .description {
        color: var(--muted);
        margin: 0.5rem 0 0;
        font-style: italic;
    }

    .meta {
        color: var(--muted);
        font-size: 0.9rem;
        margin: 1.75rem 0 0;
    }

    .reading-time {
        margin-top: 0.75rem;
    }

    .back {
        margin: 1.5rem 0 0;
        font-weight: 700;
        font-size: 1.1rem;
    }

    /* same link again after the body, so nobody scrolls back up */
    .back-bottom {
        margin-top: 2.5rem;
    }

    .back a {
        position: relative;
        text-decoration: none;
    }

    .back a::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -0.2rem;
        width: 100%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.2s ease;
    }

    .back a:hover::after,
    .back a:focus-visible::after {
        transform: scaleX(1);
    }

    /* JS-created, so unscoped; the wrapper anchors the corner button */
    article :global(.code-block) {
        position: relative;
    }

    /* revealed on hover of the block (always shown where hover
       doesn't exist), in the feed-URL button's style */
    article :global(.copy-code) {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        display: inline-flex;
        align-items: center;
        padding: 0.3rem;
        background: none;
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--muted);
        cursor: pointer;
        opacity: 0;
        transition:
            opacity 0.15s ease,
            color 0.15s ease,
            border-color 0.15s ease;
    }

    article :global(.code-block:hover .copy-code),
    article :global(.copy-code:focus-visible),
    article :global(.copy-code.copied) {
        opacity: 1;
    }

    @media (hover: none) {
        article :global(.copy-code) {
            opacity: 1;
        }
    }

    article :global(.copy-code:hover),
    article :global(.copy-code:focus-visible) {
        color: var(--accent);
        border-color: var(--accent);
    }

    article :global(.copy-code svg) {
        width: 1rem;
        height: 1rem;
    }

    article :global(.copy-code .check) {
        display: none;
        color: var(--green);
    }

    article :global(.copy-code.copied .copy) {
        display: none;
    }

    article :global(.copy-code.copied .check) {
        display: block;
    }

    /* markdown content isn't scoped, hence the :global() */
    article :global(img.zoomable) {
        cursor: zoom-in;
        transition: transform 0.25s ease;
    }

    article :global(img.zoomable:hover) {
        transform: scale(1.03);
    }

    .lightbox {
        padding: 0;
        border: none;
        background: transparent;
        max-width: 92vw;
        max-height: 92vh;
        cursor: zoom-out;
        /* the dialog receives focus on open; its ring frames the screen */
        outline: none;
    }

    .lightbox::backdrop {
        background: rgba(0, 0, 0, 0.85);
    }

    .lightbox img {
        display: block;
        /* fixed viewport-sized box: contain scales any aspect ratio
           up or down to fill it, so wide images open large too */
        width: 92vw;
        height: 92vh;
        object-fit: contain;
    }
</style>
