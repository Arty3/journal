---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readingTime, sortedEntries, visibleStatus } from '../../lib/entries';

export async function getStaticPaths() {
    const entries = await sortedEntries();
    return entries.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
    title={`${entry.data.title} — ${readingTime(entry)} min — Luca's Journal`}
    description={entry.data.description}
>
    <article>
        <header>
            <h1>{entry.data.title}</h1>
            <p class="description">{entry.data.description}</p>
            {
                (entry.data.written || entry.data.project || visibleStatus(entry)) && (
                    <p class="meta">
                        {entry.data.written && <span>Written: {entry.data.written}</span>}
                        {entry.data.project && <span>Project: {entry.data.project}</span>}
                        {visibleStatus(entry) && (
                            <span class="status-ongoing">Status: {visibleStatus(entry)}</span>
                        )}
                    </p>
                )
            }
            {
                entry.data.tags.length > 0 && (
                    <ul class="tags">
                        {entry.data.tags.map((tag) => (
                            <li>
                                <a href={`/tags/${tag}/`}>{tag}</a>
                            </li>
                        ))}
                    </ul>
                )
            }
            <span class="reading-time">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
                {readingTime(entry)} min
            </span>
            <p class="back">
                <a href="/entries/">&larr; All entries</a>
            </p>
        </header>
        <Content />
    </article>
</Base>

<script>
    const blocks = document.querySelectorAll('pre > code.language-mermaid');

    if (blocks.length > 0) {
        const { default: mermaid } = await import('mermaid');

        mermaid.initialize({
            startOnLoad: false,
            theme: window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'default',
            fontFamily:
                "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
        });

        for (const code of blocks) {
            const pre = code.parentElement;
            if (!pre) continue;
            const container = document.createElement('pre');
            container.className = 'mermaid';
            container.textContent = code.textContent ?? '';
            pre.replaceWith(container);
        }

        await mermaid.run({ querySelector: 'pre.mermaid' });
    }
</script>

<style>
    article > header {
        margin-bottom: 2.5rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--border);
    }

    .description {
        color: var(--muted);
        margin: 0.5rem 0 0;
    }

    .meta {
        color: var(--muted);
        font-size: 0.9rem;
        margin: 0.6rem 0 0;
    }

    .meta span + span::before {
        content: '·';
        margin: 0 0.5rem;
    }

    .meta .status-ongoing {
        color: var(--green);
    }

    .reading-time {
        margin-top: 0.75rem;
    }

    .back {
        margin: 1.5rem 0 0;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .back a {
        position: relative;
        text-decoration: none;
    }

    .back a::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -0.2rem;
        width: 100%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.2s ease;
    }

    .back a:hover::after {
        transform: scaleX(1);
    }
</style>
