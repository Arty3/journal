---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { sortedEntries, tagCounts } from '../../lib/entries';

export async function getStaticPaths() {
    const entries = await sortedEntries();
    return [...tagCounts(entries).keys()].map((tag) => ({
        params: { tag },
        props: { entries: entries.filter((entry) => entry.data.tags.includes(tag)) },
    }));
}

const { tag } = Astro.params;
const { entries } = Astro.props;
---

<Base title={`Tagged “${tag}” — Luca's Journal`} description={`Journal entries tagged ${tag}.`}>
    <h1>Tagged “{tag}”</h1>
    <p class="back"><a href="/entries/">&larr; All entries</a></p>
    <EntryList entries={entries} />
</Base>

<style>
    /* the same back link as on entry pages: UI face, animated underline */
    .back {
        margin-bottom: 2rem;
        font-family: var(--font-ui);
        font-weight: 700;
        font-size: 1.1rem;
    }

    .back a {
        position: relative;
        text-decoration: none;
    }

    .back a::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -0.2rem;
        width: 100%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.2s ease;
    }

    .back a:hover::after,
    .back a:focus-visible::after {
        transform: scaleX(1);
    }
</style>
